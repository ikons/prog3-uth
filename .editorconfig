root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,py}]
indent_style = space
indent_size = 4

# Οι εντολές ενός κανόνα ξεκινούν με TAB.
[{Makefile,*.make}]
indent_style = tab

# Σκόπιμα με κενά: το λάθος του TAB (12.2).
[make/spaces.make]
indent_style = space
